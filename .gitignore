# --- Documentation --------------------------------------------------------
# Quarto build output (rendered HTML; regenerate with `quarto render vignettes`).
# vignettes/_freeze/ is intentionally NOT ignored - Quarto's freeze cache is
# committed so the docs site can be rebuilt/deployed without re-fetching every
# real dataset (network access to Bioconductor/BiocPy services) on every build.
vignettes/_site/
vignettes/.quarto/
vignettes/_freeze_assets/
vignettes/*.quarto_ipynb

# quartodoc output. Generated from docstrings by `quartodoc build`; regenerate
# rather than editing by hand.
vignettes/reference/
vignettes/objects.json

# Sphinx build output and the sphinx-apidoc pages, which docs/conf.py
# regenerates from the package on every build.
docs/_build/
docs/api/

# Legacy MkDocs output (MkDocs is no longer the site renderer).
/site/

# --- Editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
